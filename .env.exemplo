# Copie este arquivo para ".env" (o iniciar.bat faz isso sozinho na primeira vez) e preencha.
# O arquivo ".env" NAO vai para o Git (esta no .gitignore): ele guarda os enderecos do SEU servidor.

# Endereco da API do Legis Videos da sua instituicao (termina em /)
LEGIS_API=https://api-SEU-LEGISVIDEOS.exemplo.leg.br/

# Endereco do painel (usado para abrir o video no botao "Abrir no Legis Videos")
LEGIS_ADMIN_URL=https://admin-SEU-LEGISVIDEOS.exemplo.leg.br/

# Opcionais
# WHISPER_MODEL=small
# OLLAMA_MODEL=qwen2.5:3b-instruct
